<?php

use Illuminate\Console\Concerns\InteractsWithIO;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\Schema;
use Symfony\Component\Console\Output\ConsoleOutput;
use TimoKoerber\LaravelOneTimeOperations\OneTimeOperation;

/**
 * $HEADLINE$
 *
 * Ensure $REVISIONS_TABLE$ exists for installs that already ran the module migration
 * before revisions were added.
 *
 * Generated by modularous:remake:revisions.
 */
return new class extends OneTimeOperation
{
    use InteractsWithIO;

    public function __construct()
    {
        $this->output = new ConsoleOutput;
    }

    protected bool $async = false;

    protected string $queue = 'default';

    protected ?string $tag = 'revision';

    public function process(): void
    {
        $parentTable = '$PARENT_TABLE$';
        $revisionsTable = '$REVISIONS_TABLE$';

        if (Schema::hasTable($revisionsTable)) {
            $this->output->writeln("Modularous: {$revisionsTable} already exists — skipped");

            return;
        }

        if (! Schema::hasTable($parentTable)) {
            $this->output->writeln("Modularous: {$parentTable} missing — cannot create {$revisionsTable}");

            return;
        }

        Schema::create($revisionsTable, function (Blueprint $table) use ($parentTable): void {
            createDefaultRevisionsTableFields($table, '$SINGULAR$', $parentTable);
        });

        $this->output->writeln("Modularous: created {$revisionsTable} ($SINGULAR$_id → {$parentTable})");
    }
};
