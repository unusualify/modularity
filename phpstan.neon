includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    # Raised level by level; keep in sync with quality.json phpstan.level
    level: 4
    tmpDir: .phpstan.cache
    paths:
        - src
        - modules
        - config
        - database
        - routes
    excludePaths:
        - '*.blade.php'
        # Extends Kalnoy\Nestedset\Collection, but kalnoy/nestedset is not a dependency
        - src/Entities/NestedsetCollection.php
    bootstrapFiles:
        - phpstan-bootstrap.php
    # Package config lives in config/, config/merges and config/publishes (not config_path())
    configDirectories:
        - %currentWorkingDirectory%/config
    # Model attributes are inferred from these migrations (Testbench's database_path() has none)
    databaseMigrationsPath:
        - %currentWorkingDirectory%/database/migrations
        - %currentWorkingDirectory%/modules/Cms/Database/Migrations
        - %currentWorkingDirectory%/modules/ErrorPage/Database/Migrations
        - %currentWorkingDirectory%/modules/SystemNotification/Database/Migrations
        - %currentWorkingDirectory%/modules/SystemPayment/Database/Migrations
        - %currentWorkingDirectory%/modules/SystemPricing/Database/Migrations
        - %currentWorkingDirectory%/modules/SystemSetting/Database/Migrations
        - %currentWorkingDirectory%/modules/SystemUser/Database/Migrations
        - %currentWorkingDirectory%/modules/SystemUtility/Database/Migrations
    ignoreErrors:
        # Eloquent sets $pivot dynamically on models loaded through belongsToMany
        -
            identifier: property.notFound
            message: '#::\$pivot\.$#'
        # BaseCommand guards every shared option with hasOption(); Larastan reports the
        # guarded call once per subclass that lacks the option.
        -
            identifier: larastan.console.undefinedOption
            path: src/Console/BaseCommand.php
